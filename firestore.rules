rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'friendCode', 'availability', 'createdAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // A friend code exposes only the name and code identity. Legacy availability
    // fields are readable only by their owner until that profile is refreshed.
    match /friendCodes/{code} {
      allow get: if signedIn()
        && (!resource.data.keys().hasAny(['availability']) || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /friendships/{pairId} {
      allow get, list: if signedIn()
        && resource.data.memberUids is list
        && resource.data.memberUids.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.friendCode is string
        && exists(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode))
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid in request.resource.data.memberUids
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid != request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.memberUids.hasAny([request.auth.uid]);
    }

    // Groups are private to their owner; only explicit availability and menu
    // membership snapshots are shared with selected group members.
    match /groups/{groupId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.availability is list
        && request.resource.data.availability.size() == 7
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'ownerUid', 'memberUids', 'availability', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.availability is list
        && request.resource.data.availability.size() == 7
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'ownerUid', 'memberUids', 'availability', 'createdAt', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /groupAvailability/{shareId} {
      allow get, list: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.visibleTo is list && request.auth.uid in resource.data.visibleTo)
      );
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibleTo is list
        && request.auth.uid in request.resource.data.visibleTo
        && request.resource.data.availability is list
        && request.resource.data.availability.size() == 7
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'groupId', 'groupName', 'displayName', 'visibleTo', 'availability', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /menus/{menuId} {
      allow get, list: if signedIn()
        && resource.data.memberUids is list
        && resource.data.memberUids.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.contributions is list
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'date', 'note', 'accepting', 'contributions',
          'collaborators', 'ownerUid', 'memberUids', 'audienceGroupIds',
          'audienceGroupNames', 'directInviteUids', 'createdAt', 'updatedAt'
        ]);

      // Hosts manage access and menu details. Collaborators may append one
      // contribution while the host is accepting them, without editing old entries.
      allow update: if signedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids is list
          && request.auth.uid in request.resource.data.memberUids
        ) || (
          resource.data.memberUids.hasAny([request.auth.uid])
          && resource.data.accepting == true
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contributions', 'updatedAt'])
          && request.resource.data.contributions is list
          && request.resource.data.contributions.size() == resource.data.contributions.size() + 1
          && request.resource.data.contributions.hasAll(resource.data.contributions)
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
